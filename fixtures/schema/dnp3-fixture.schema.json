{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/dnp3-interop/fixtures/schema/dnp3-fixture.schema.json",
  "title": "dnp3-interop fixture",
  "description": "A simulated DNP3 outstation: its link addresses, its point database and what controls do to it. See docs/FIXTURES.md for the behaviour every server adapter derives from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "outstation"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string" },
    "outstation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "masterAddress"],
      "properties": {
        "address": { "$ref": "#/$defs/linkAddress" },
        "masterAddress": { "$ref": "#/$defs/linkAddress" },
        "unsolicited": { "type": "boolean" },
        "needTime": { "type": "boolean" },
        "coldRestartDelayMs": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "warmRestartDelayMs": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "maxControlsPerRequest": { "description": "Contract 1.3: the most control objects the outstation carries out in one request.", "type": "integer", "minimum": 1, "maximum": 255 }
      }
    },
    "binaryInputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "boolean" },
        "flags": { "$ref": "#/$defs/binaryFlags" },
        "staticVariation": { "enum": [1, 2] },
        "eventVariation": { "enum": [1, 2] } }, "unevaluatedProperties": false }
    },
    "doubleBitInputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 3 },
        "flags": { "$ref": "#/$defs/binaryFlags" },
        "staticVariation": { "enum": [2] },
        "eventVariation": { "enum": [1, 2] } }, "unevaluatedProperties": false }
    },
    "binaryOutputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "boolean" },
        "flags": { "$ref": "#/$defs/outputFlags" },
        "staticVariation": { "enum": [2] },
        "eventVariation": { "enum": [1, 2] },
        "target": { "$ref": "#/$defs/index" },
        "selectRequired": { "type": "boolean" },
        "commandEventClass": { "$ref": "#/$defs/eventClass" },
        "commandEventVariation": { "enum": [1, 2] } }, "unevaluatedProperties": false }
    },
    "counters": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "flags": { "$ref": "#/$defs/counterFlags" },
        "staticVariation": { "enum": [1, 2, 5, 6] },
        "eventVariation": { "enum": [1, 2, 5, 6] } }, "unevaluatedProperties": false }
    },
    "frozenCounters": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "flags": { "$ref": "#/$defs/counterFlags" },
        "staticVariation": { "enum": [1, 2, 5, 6, 9, 10] },
        "eventVariation": { "enum": [1, 2, 5, 6] } }, "unevaluatedProperties": false }
    },
    "analogInputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "number" },
        "flags": { "$ref": "#/$defs/analogFlags" },
        "staticVariation": { "enum": [1, 2, 3, 4, 5, 6] },
        "eventVariation": { "enum": [1, 2, 3, 4, 5, 6, 7, 8] } }, "unevaluatedProperties": false }
    },
    "analogOutputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "number" },
        "flags": { "$ref": "#/$defs/analogFlags" },
        "staticVariation": { "enum": [1, 2, 3, 4] },
        "eventVariation": { "enum": [1, 2, 3, 4, 5, 6, 7, 8] },
        "target": { "$ref": "#/$defs/index" },
        "selectRequired": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "commandEventClass": { "$ref": "#/$defs/eventClass" },
        "commandEventVariation": { "enum": [1, 2, 3, 4, 5, 6, 7, 8] } }, "unevaluatedProperties": false }
    },
    "frozenAnalogInputs": {
      "description": "Frozen analog inputs, groups 31 and 33.",
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "number" },
        "flags": { "$ref": "#/$defs/analogFlags" },
        "staticVariation": { "enum": [1, 2, 5, 6, 7, 8] },
        "eventVariation": { "enum": [1, 2, 5, 6] } }, "unevaluatedProperties": false }
    },
    "timeAndIntervals": {
      "description": "Time and interval objects, group 50 variation 4. Static only: they produce no events.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "time", "interval", "units"],
        "properties": {
          "index": { "$ref": "#/$defs/index" },
          "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
          "interval": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
          "units": { "type": "integer", "minimum": 0, "maximum": 11 }
        }
      }
    },
    "octetStrings": {
      "type": "array",
      "items": { "$ref": "#/$defs/point", "properties": {
        "value": { "type": "string", "pattern": "^([0-9a-f]{2}){1,255}$" } }, "unevaluatedProperties": false }
    },
    "files": {
      "description": "Files the outstation serves by DNP3 file transfer (group 70). Only adapters with the feature fileServer serve a fixture that has them.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "content"],
        "properties": {
          "name": { "$ref": "#/$defs/fileName" },
          "content": { "type": "string", "pattern": "^([0-9a-f]{2}){0,65536}$" }
        }
      }
    },
    "deviceAttributes": {
      "description": "Device attributes, group 0 (contract 1.3). Served only by adapters with the feature deviceAttributesServer.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["set", "variation", "type", "value"],
        "properties": {
          "set": { "type": "integer", "minimum": 1, "maximum": 255 },
          "variation": { "type": "integer", "minimum": 1, "maximum": 253 },
          "type": { "enum": ["visibleString", "unsignedInt", "signedInt"] },
          "value": { "type": ["string", "integer"] },
          "writable": { "type": "boolean" }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "visibleString" } } }, "then": { "properties": { "value": { "type": "string", "maxLength": 255 } } } },
          { "if": { "properties": { "type": { "const": "unsignedInt" } } }, "then": { "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 4294967295 } } } },
          { "if": { "properties": { "type": { "const": "signedInt" } } }, "then": { "properties": { "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } } } }
        ]
      }
    },
    "directories": {
      "description": "Directories the outstation serves besides those that hold files: empty ones.",
      "type": "array",
      "items": { "$ref": "#/$defs/fileName" }
    }
  },
  "$defs": {
    "linkAddress": { "type": "integer", "minimum": 0, "maximum": 65519 },
    "index": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "eventClass": { "enum": [1, 2, 3] },
    "fileName": { "type": "string", "pattern": "^(/[A-Za-z0-9_-][A-Za-z0-9._-]*)+$", "maxLength": 200 },
    "point": {
      "type": "object",
      "required": ["index", "value"],
      "properties": {
        "index": { "$ref": "#/$defs/index" },
        "value": true,
        "class": { "enum": [0, 1, 2, 3] }
      }
    },
    "binaryFlags": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["ONLINE", "RESTART", "COMM_LOST", "REMOTE_FORCED", "LOCAL_FORCED", "CHATTER_FILTER"] }
    },
    "outputFlags": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["ONLINE", "RESTART", "COMM_LOST", "REMOTE_FORCED", "LOCAL_FORCED"] }
    },
    "counterFlags": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["ONLINE", "RESTART", "COMM_LOST", "REMOTE_FORCED", "LOCAL_FORCED", "DISCONTINUITY"] }
    },
    "analogFlags": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["ONLINE", "RESTART", "COMM_LOST", "REMOTE_FORCED", "LOCAL_FORCED", "OVER_RANGE", "REFERENCE_ERR"] }
    }
  }
}
