{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/otfabric/dnp3-interop/schemas/capabilities.schema.json",
  "title": "dnp3-interop capability document",
  "description": "Output of 'print-capabilities'. See docs/CAPABILITIES.md.",
  "type": "object",
  "required": ["schemaVersion", "adapter", "adapterVersion", "protocol", "upstream", "roles", "features",
               "pointTypes", "commandTypes", "clientOperations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "adapter": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "protocol": { "const": "dnp3" },
    "upstream": {
      "type": "object",
      "required": ["name", "version", "revision", "license", "language", "independentEngine"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "revision": { "type": "string" },
        "license": { "type": "string" },
        "language": { "type": "string" },
        "independentEngine": { "type": "boolean" }
      }
    },
    "roles": {
      "type": "object",
      "required": ["server", "client"],
      "properties": { "server": { "type": "boolean" }, "client": { "type": "boolean" } }
    },
    "features": {
      "type": "object",
      "required": ["integrityPoll", "eventPoll", "read", "readAllObjectsClient", "directOperate", "selectBeforeOperate", "parameterErrorWithNotSupported", "directOperateNoAckServer", "directOperateNoAckClient",
                   "timeSyncLan", "timeSyncNonLan", "timeSyncOnDemand", "restart", "restartDelayClient", "unsolicited", "assignClassServer", "assignClassClient",
                   "freeze", "freezeNoAckServer", "freezeNoAckClient", "octetStrings", "tcp", "udp", "tls", "serial", "fileTransfer",
                   "fileServer", "fileClient", "fileDeleteClient", "secureAuthentication"],
      "additionalProperties": { "type": "boolean" }
    },
    "pointTypes": {
      "type": "array",
      "items": { "enum": ["binaryInputs", "doubleBitInputs", "binaryOutputs", "counters", "frozenCounters",
                          "analogInputs", "analogOutputs", "octetStrings", "frozenAnalogInputs", "timeAndIntervals"] }
    },
    "commandTypes": { "type": "array", "items": { "enum": ["g12v1", "g41v1", "g41v2", "g41v3", "g41v4"] } },
    "clientOperations": { "type": "array", "items": { "type": "string" } },
    "frozenEventPolicies": {
      "description": "Contract 1.4: the policies of the outstation for a freeze that leaves a frozen value as it was, the default first. on-change raises no frozen counter event, always raises one. Two entries: --frozen-event-policy picks. One: fixed. None: no frozen counter events at all.",
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["on-change", "always"] }
    },
    "frozenEventRetention": {
      "description": "Contract 1.4: what the outstation keeps of a point's frozen counter events until a master confirms them: all, or only the most recent. Absent when it raises none.",
      "enum": ["all", "most-recent"]
    },
    "unsupportedReasons": {
      "description": "Contract 1.4: why a feature declared false is missing, by feature name, where a consumer reports it.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "serverFeatures": {
      "description": "Contract 1.2: features whose value for the server role differs from features.",
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "secureAuthentication": {
      "description": "Contract 1.1: what secure authentication (SAv5) has, in an image that declares the feature secureAuthentication.",
      "type": "object",
      "required": ["macAlgorithms", "keyWrapAlgorithms", "criticalFunctions", "aggressiveMode"],
      "properties": {
        "macAlgorithms": { "type": "array", "items": { "enum": ["hmac-sha1-4", "hmac-sha1-8", "hmac-sha1-10", "hmac-sha256-8",
                                                                "hmac-sha256-16", "aes-gmac"] } },
        "keyWrapAlgorithms": { "type": "array", "items": { "enum": ["aes-128", "aes-256"] } },
        "criticalFunctions": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 255 } },
        "aggressiveMode": { "type": "boolean" }
      }
    }
  }
}
